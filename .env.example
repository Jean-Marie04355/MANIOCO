# Infrastructure Configuration
# ----------------------------

# App Environment
NODE_ENV=development
PORT=3000

# PostgreSQL (TypeORM)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=afrigari

# MongoDB (Mongoose)
MONGODB_URI=mongodb://localhost:27017/afrigari

# Redis (Cache & BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional: REDIS_URL=redis://localhost:6379

# BullMQ
BULLMQ_QUEUE=afrigari_default

# S3 Compatible Storage (Minio / AWS / Garage)
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password
S3_BUCKET_NAME=afrigari-bucket

# Auth & Security
JWT_SECRET=super-secret-key-change-it
FRONTEND_URL=http://localhost:3000

# Swagger Basic Auth
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin

# Email Configuration (SMTP)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-pass
SMTP_FROM="Afrigari <noreply@afrigari.com>"
